{
  "name": "shipment-entry-workbench",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "sample": "tsx scripts/sample.ts",
    "integration": "node --import tsx scripts/integration.ts",
    "export-chat": "node --import tsx scripts/export-chat.ts",
    "format": "prettier --write src server shared tests scripts/*.ts vite.config.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@tesseract.js-data/eng": "^1.0.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.3.0",
    "multer": "^2.0.2",
    "openai": "^6.0.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tesseract.js": "^6.0.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.9",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
